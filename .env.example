# For HTTP-only testing via VPS IP (never real customer info/payment details):
SITE_ADDRESS=:80
# For HTTPS production, use a domain with DNS A record pointed to VPS:
# SITE_ADDRESS=repair.yourdomain.com
HTTP_PORT=80
HTTPS_PORT=443

MYSQL_DATABASE=repair_management
MYSQL_USER=repair_app
MYSQL_PASSWORD=CHANGE_ME_RANDOM_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_ROOT_DB_PASSWORD
# Run: openssl rand -base64 48
JWT_SECRET_BASE64=CHANGE_ME_RANDOM_BASE64_JWT_SECRET

# Usually not needed because the browser and API use the same origin /api.
# For development access from Angular localhost:4200 you may set that origin.
CORS_ALLOWED_ORIGINS=http://localhost:4200

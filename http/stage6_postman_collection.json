      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{ownerEmail}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{ownerPassword}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/companies/{{companyId}}/invoices",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "companies",
            "{{companyId}}",
            "invoices"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"taxAmount\": 0\n}",
